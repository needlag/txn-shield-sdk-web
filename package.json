{
  "name": "@txnshield/sdk-web",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "examples"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsup src/index.ts --format esm,cjs --dts",
    "publish:dry-run": "pnpm build && npm publish --dry-run --access public",
    "test": "../../node_modules/.bin/vitest run --passWithNoTests",
    "lint": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {}
}
